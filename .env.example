# =============================================================================
# Health Dashboard — Environment Variables (Docker Compose)
# =============================================================================
# Copie este arquivo para .env e preencha os valores:
#   cp .env.example .env
# =============================================================================

# --- Database (MySQL 8.0) ---
DB_DATABASE=db_health_dashboard
DB_USERNAME=db_user
DB_PASSWORD=db_senha
DB_ROOT_PASSWORD=root

# --- JWT Authentication ---
# TODO(security): Generate a strong random key for production.
JWT_SECRET=health_dashboard_jwt_secret_key_change_in_production

# --- Groq API (LLM) ---
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

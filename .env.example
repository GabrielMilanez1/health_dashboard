# =============================================================================
# Health Dashboard — Environment Variables (Docker Compose)
# =============================================================================
# Copie este arquivo para .env e preencha os valores:
#   cp .env.example .env
# =============================================================================

# --- Database (MySQL 8.0) ---
DB_DATABASE=db_health_dashboard
DB_USERNAME=db_user
DB_PASSWORD=db_senha
DB_ROOT_PASSWORD=root

# --- Google Gemini API ---
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
